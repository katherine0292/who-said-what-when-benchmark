{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "turn",
  "type": "object",
  "properties": {
    "clip_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "integer",
      "minimum": 1
    },
    "speaker_id": {
      "type": "string",
      "pattern": "^spk_[0-9]{2,}$"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "clock_status": {
      "enum": [
        "legacy",
        "exceeds_audio",
        "invalid_legacy_clock"
      ]
    }
  },
  "required": [
    "clip_id",
    "turn_id",
    "speaker_id",
    "start_ms",
    "end_ms",
    "clock_status"
  ],
  "additionalProperties": false
}
