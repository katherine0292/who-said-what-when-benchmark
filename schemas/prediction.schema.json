{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prediction",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wsw_[0-9]{4,}$"
    },
    "speaker_id": {
      "type": "string",
      "pattern": "^spk_[0-9]{2,}$"
    },
    "evidence_ms": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "identity_name": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false
}
