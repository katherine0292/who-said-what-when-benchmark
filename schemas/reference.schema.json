{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reference",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wsw_[0-9]{4,}$"
    },
    "clip_id": {
      "type": "string",
      "minLength": 1
    },
    "speaker_id": {
      "type": "string",
      "pattern": "^spk_[0-9]{2,}$"
    },
    "identity_ref": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false
    },
    "voice_ref": {
      "type": "object",
      "properties": {
        "accent_impression": {
          "type": "string",
          "minLength": 1
        },
        "timbre": {
          "type": "string",
          "minLength": 1
        },
        "prosody": {
          "type": "string",
          "minLength": 1
        },
        "relative_volume": {
          "type": "string",
          "minLength": 1
        },
        "rhythm": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "tone_ref": {
      "enum": [
        "neutral",
        "animated",
        "warm",
        "encouraging",
        "explanatory",
        "reflective",
        "concerned",
        "inquiring",
        "emphatic",
        "unknown"
      ]
    },
    "tone_source": {
      "type": "string",
      "minLength": 1
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 4
    },
    "evidence_ms": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    },
    "turn_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "text_aligned",
        "needs_media_review"
      ]
    },
    "split": {
      "const": "pilot"
    }
  },
  "required": [
    "id",
    "clip_id",
    "speaker_id",
    "identity_ref",
    "voice_ref",
    "tone_ref",
    "tone_source",
    "key_points",
    "evidence_ms",
    "turn_ids",
    "status",
    "split"
  ],
  "additionalProperties": false
}
