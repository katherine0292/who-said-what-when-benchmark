{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "input",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wsw_[0-9]{4,}$"
    },
    "clip_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "const": "en"
    },
    "question": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "clip_id",
    "duration_ms",
    "language",
    "question"
  ],
  "additionalProperties": false
}
